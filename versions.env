# Pinned versions -- single source of truth for local builds and CI.
#
# Sourced by the build scripts (build/, deps/) and by .github/workflows/wheels.yml.
# The published wheel version is derived from the ESMF source (see
# esmf/src/addon/esmpy/build_utils/version.py), so ESMF_TAG determines the version.

# ESMF source for the wheel build (fetched by scripts/fetch_esmf.sh into ./esmf).
# The wheel's esmpy is built from this source, so it MUST contain the wheel-aware
# loader change (bundled esmf.mk discovery + relative ESMF_LIBSDIR resolution).
# Until that change is merged upstream, build against the fork/branch that has it.
# TODO: switch to ESMF_REPO_URL=https://github.com/esmf-org/esmf.git + a release
# tag (e.g. ESMF_REF=v9.0.0) once the loader change lands in esmf-org.
ESMF_REPO_URL=https://github.com/xylar/esmf.git
ESMF_REF=update-mingw-support

# Native dependency versions. These mirror the stack ESMF's own CI builds in
# .github/workflows/esmf-all-tests.yml -- keep them in sync when bumping.
HDF5_VERSION=1.14.4.3
NETCDF_C_VERSION=4.9.0
NETCDF_FORTRAN_VERSION=4.5.4

# MPICH for the MPI-enabled variant (ESMF_COMM=mpich). Built from source at BUILD
# time because the PyPI `mpich` *runtime* wheel ships no headers/mpicc/mpif90. The
# version is pinned to what that runtime wheel bundles so the wheel's libmpi.so.12
# (the MPICH ABI soname) is a drop-in for our source-built one at RUN time -- the
# esmpy-mpich wheel depends on `mpich` and does NOT vendor libmpi. Bump this in
# lockstep with the `mpich` PyPI wheel it pairs with.
MPICH_VERSION=5.0.1

# Source tarball URLs. Use release tarballs that ship a bootstrapped `configure`
# (GitHub git-tag archives do NOT, for netcdf). HDF5's asset naming is irregular
# (tag hdf5_1.14.4.3 ships hdf5-1.14.4-3.tar.gz), so it is pinned explicitly.
HDF5_URL=https://github.com/HDFGroup/hdf5/releases/download/hdf5_${HDF5_VERSION}/hdf5-1.14.4-3.tar.gz
NETCDF_C_URL=https://downloads.unidata.ucar.edu/netcdf-c/${NETCDF_C_VERSION}/netcdf-c-${NETCDF_C_VERSION}.tar.gz
NETCDF_FORTRAN_URL=https://downloads.unidata.ucar.edu/netcdf-fortran/${NETCDF_FORTRAN_VERSION}/netcdf-fortran-${NETCDF_FORTRAN_VERSION}.tar.gz
# MPICH release tarballs ship a bootstrapped `configure`.
MPICH_URL=https://www.mpich.org/static/downloads/${MPICH_VERSION}/mpich-${MPICH_VERSION}.tar.gz

# ESMF build configuration. Serial (mpiuni) is the default; the MPI-enabled
# variant is selected by exporting ESMF_COMM=mpich in the environment (per CI
# matrix entry) BEFORE the build scripts source this file -- hence the ${VAR:-...}
# form, which preserves an already-set value instead of clobbering it. Both the
# deps build (build_mpich) and the ESMF build key off ESMF_COMM.
ESMF_COMM="${ESMF_COMM:-mpiuni}"
ESMF_BOPT="${ESMF_BOPT:-O}"
